# คัดลอกไฟล์นี้เป็น .env แล้วใส่คีย์จริง
# ห้ามใส่คีย์ใน frontend หรือ commit ไฟล์ .env
#
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=ใส่คีย์ตรงนี้
GEMINI_MODEL=gemini-2.5-flash
#
# Snowflake SQL API (อ่านอย่างเดียวจาก cafe_db.sales.ORDERS)
# ใส่ได้ทั้ง account identifier (xy12345 / org-account)
# หรือ URL เต็ม: https://<account>.snowflakecomputing.com
SNOWFLAKE_PAT=ใส่โทเคนตรงนี้
SNOWFLAKE_ACCOUNT=ใส่ account identifier
